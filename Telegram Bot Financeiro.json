    {
      "parameters": {
        "jsCode": "const textOutput = $json.output || $json.text || $json.response || $json.answer || $json.message;\n\nlet parsed;\ntry {\n  const cleaned = textOutput.replace(/```json/gi, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error('Erro ao ler JSON: ' + textOutput);\n}\n\n// Mapeamento do intent para o tipo de dado\nconst intentToType = {\n  add_expense: 'expense',\n  add_income: 'income',\n  reset_all: 'reset_all',\n  reset_expenses: 'reset_expenses',\n  reset_income: 'reset_income',\n  mark_expenses_paid: 'mark_expenses_paid'\n};\n\n// Retorna APENAS as colunas que existem na tabela\nreturn [{\n  json: {\n    type: intentToType[parsed.intent] || parsed.intent,\n    amount: Number(parsed.amount) || 0,\n    category: parsed.category || 'Outros',\n    description: parsed.description || '',\n    date: parsed.date || new Date().toISOString().slice(0, 10),\n    status: 'paid'\n  }\n}];"
      },
