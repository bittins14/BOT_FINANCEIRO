      "id": "eca77917-5549-4086-a38d-e28bd5eb9d13",
      "name": "Get Database (Debts)",
      "type": "n8n-nodes-base.dataTable",
      "position": [
        0,
        576
      ],
      "typeVersion": 1.1
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nconst time = (row) => {\n  const value = row.createdAt || row.date;\n  return value ? new Date(value).getTime() : 0;\n};\n\nconst latest = (types) => rows\n  .filter(row => types.includes(row.type))\n  .reduce((max, row) => Math.max(max, time(row)), 0);\n\nconst allResetAt = latest(['reset_all']);\nconst incomeResetAt = Math.max(allResetAt, latest(['reset_income']));\nconst expenseResetAt = Math.max(allResetAt, latest(['reset_expenses']));\n\nconst income = rows\n  .filter(row => row.type === 'income' && time(row) > incomeResetAt)\n  .reduce((sum, row) => sum + Number(row.amount || 0), 0);\n\nconst expense = rows\n  .filter(row => row.type === 'expense' && time(row) > expenseResetAt)\n  .reduce((sum, row) => sum + Number(row.amount || 0), 0);\n\nconst balance = income - expense;\n\nreturn [{\n  json: {\n    telegramMessage:\n      `Seu saldo atual é R$ ${balance.toFixed(2)}\\n\\n` +\n      `Receitas: R$ ${income.toFixed(2)}\\n` +\n      `Despesas: R$ ${expense.toFixed(2)}`\n  }\n}];"
      },
      "id": "ad2e7991-09c9-4bf8-8eeb-cc70912b572b",
      "name": "Calculate Balance",
      "type": "n8n-nodes-base.code",
      "position": [
        224,
        384
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\nconst assistantOutput = $('Parse Assistant JSON').item.json;\nconst targetMonth = assistantOutput.target_month || new Date().toISOString().slice(0, 7);\n\nconst time = (row) => {\n  const value = row.createdAt || row.date;\n  return value ? new Date(value).getTime() : 0;\n};\n};\nconst monthOf = (row) => row.date ? new Date(row.date).toISOString().slice(0, 7) : '';\nconst latest = (types) => rows\n  .filter(row => types.includes(row.type))\n  .reduce((max, row) => Math.max(max, time(row)), 0);\n\nconst resetAt = Math.max(latest(['reset_all']), latest(['reset_expenses']));\nconst paidAt = latest(['mark_expenses_paid']);\n\nconst expenses = rows.filter(row => {\n  const rowTime = time(row);\n  return row.type === 'expense' &&\n    monthOf(row) === targetMonth &&\n    rowTime > resetAt &&\n    rowTime > paidAt;\n});\n\nconst total = expenses.reduce((sum, row) => sum + Number(row.amount || 0), 0);\n\nreturn [{\n  json: {\n    telegramMessage: `Suas despesas em ${targetMonth} somam R$ ${total.toFixed(2)}.`\n  }\n}];"
      },
